PORT=5000

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=stocknest
DB_PORT=3306

JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=8h

# Shown at the top of printed receipts
SHOP_NAME=StockNest Shop
SHOP_ADDRESS=Nairobi, Kenya
SHOP_PHONE=+254 700 000 000

# Let people request staff accounts from the sign-up page (an admin approves them)
ALLOW_SIGNUP=true

# Only needed if the website is hosted on a different address than this server
# CORS_ORIGIN=https://shop.example.com

# Optional: create the first admin automatically instead of using the setup page.
# Leave these commented out for a normal install.
# DEFAULT_ADMIN_NAME=Admin
# DEFAULT_ADMIN_EMAIL=owner@yourshop.co.ke
# DEFAULT_ADMIN_PASSWORD=choose-a-strong-password
